{
  "schema": "fpm.package/1",
  "id": "bad.runtime-activation-failure",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "dependencies": [
    { "package": "demo.simple-runtime", "range": "^0.5.0" }
  ],
  "contributions": [
    {
      "id": "pkg:bad.runtime-activation-failure/runtime/failure",
      "manifestType": "fpm.demo.runtime/1",
      "manifest": "runtime.json"
    }
  ],
  "runtimeServices": [
    {
      "id": "service:bad.runtime-activation-failure/1",
      "protocol": "fpm.runtime-service/1",
      "provides": [
        { "capability": "runtime.fixture.activation-failure", "version": "1.0.0", "exclusive": true }
      ],
      "requires": [
        { "capability": "runtime.renderer.window", "range": "^1.0.0" }
      ],
      "execution": {
        "form": "native-in-process",
        "securityBoundary": "none",
        "requestedPowers": ["host-user-authority"]
      },
      "module": "./service.mjs"
    }
  ]
}
