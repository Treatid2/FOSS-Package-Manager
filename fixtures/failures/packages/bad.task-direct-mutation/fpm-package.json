{
  "schema": "fpm.package/1",
  "id": "bad.task-direct-mutation",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "runtimeServices": [{
    "id": "service:bad.task-direct-mutation/1",
    "protocol": "fpm.runtime-service/1",
    "provides": [{
      "capability": "runtime.task", "version": "1.0.0", "exclusive": false, "cardinality": "collection",
      "member": "task:fixture.direct-mutation/1", "binding": "runtime.task.fixture-direct-mutation/1",
      "memberDependencies": [],
      "metadata": {
        "phase": "simulation", "snapshots": ["runtime.transforms.read"],
        "outputs": [{ "channel": "runtime.transforms.commands", "composition": "ordered",
          "commitAfter": ["task:demo.motion-offset/add-x/1"] }],
        "affinity": "any-worker", "reentrancy": "non-reentrant", "required": true, "failure": "abort-tick"
      }
    }],
    "requires": [],
    "execution": { "form": "native-in-process", "securityBoundary": "none", "requestedPowers": ["host-user-authority"] },
    "module": "./service.mjs"
  }]
}
