{
  "schema": "fpm.package/1",
  "id": "demo.solid-colour-adapter",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "handlers": [
    {
      "id": "handler:demo.solid-colour-adapter/1",
      "protocol": "fpm.handler-stdio/1",
      "adapts": [
        {
          "id": "adapter:demo.solid-colour-to-rgba8-srgb/1",
          "from": "texture.solid-colour/1",
          "to": "texture.runtime.rgba8-srgb/1",
          "conversion": "lossless"
        }
      ],
      "execution": {
        "form": "external-process",
        "securityBoundary": "none",
        "requestedPowers": [
          "read-declared-input-artifacts",
          "write-manager-staging"
        ]
      },
      "command": [
        "node",
        "./handler.mjs"
      ]
    }
  ]
}
