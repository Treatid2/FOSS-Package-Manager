{
  "schema": "fpm.package/1",
  "id": "demo.runtime-clock",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "runtimeServices": [
    {
      "id": "service:demo.runtime-clock/1",
      "protocol": "fpm.runtime-service/1",
      "provides": [
        { "capability": "runtime.clock.tick", "version": "1.0.0", "exclusive": true }
      ],
      "requires": [],
      "execution": {
        "form": "native-in-process",
        "securityBoundary": "none",
        "requestedPowers": ["host-user-authority"]
      },
      "module": "./service.mjs"
    }
  ]
}
