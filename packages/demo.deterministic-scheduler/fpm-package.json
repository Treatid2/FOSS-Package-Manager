{
  "schema": "fpm.package/1",
  "id": "demo.deterministic-scheduler",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "dependencies": [
    { "package": "demo.runtime-clock", "range": "^0.4.0" },
    { "package": "demo.transform-authority", "range": "^0.7.0" },
    { "package": "demo.save-coordinator", "range": "^0.7.0" }
  ],
  "runtimeServices": [
    {
      "id": "service:demo.deterministic-scheduler/1",
      "protocol": "fpm.runtime-service/1",
      "provides": [
        { "capability": "runtime.scheduler.barrier", "version": "1.0.0", "exclusive": true, "binding": "runtime.scheduler/1" },
        { "capability": "runtime.scheduler.records", "version": "1.0.0", "exclusive": true, "binding": "runtime.scheduler/1" }
      ],
      "requires": [
        { "capability": "runtime.clock.tick", "range": "^1.0.0" },
        { "capability": "runtime.task", "range": "^1.0.0", "cardinality": "collection" },
        { "capability": "runtime.transforms.read", "range": "^1.0.0", "binding": "runtime.transforms/1" },
        { "capability": "runtime.transforms.write", "range": "^1.0.0", "binding": "runtime.transforms/1" },
        { "capability": "runtime.restore.ready", "range": "^1.0.0", "binding": "runtime.persistence/1" }
      ],
      "execution": {
        "form": "native-in-process",
        "securityBoundary": "none",
        "requestedPowers": ["host-user-authority", "worker-threads", "write-tick-records"]
      },
      "module": "./service.mjs"
    }
  ]
}
