{
  "schema": "fpm.package/1",
  "id": "demo.save-coordinator",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "dependencies": [
    { "package": "demo.runtime-clock", "range": "^0.4.0" },
    { "package": "demo.runtime-instance-store", "range": "^0.5.0" },
    { "package": "demo.transform-authority", "range": "^0.5.0" }
  ],
  "runtimeServices": [
    {
      "id": "service:demo.save-coordinator/1",
      "protocol": "fpm.runtime-service/1",
      "artifactStoreAccess": "read-write",
      "provides": [
        { "capability": "runtime.persistence.world", "version": "1.0.0", "exclusive": true, "binding": "runtime.persistence/1" },
        { "capability": "runtime.restore.ready", "version": "1.0.0", "exclusive": true, "binding": "runtime.persistence/1" }
      ],
      "requires": [
        { "capability": "runtime.clock.tick", "range": "^1.0.0" },
        { "capability": "runtime.instances.state", "range": "^1.0.0", "binding": "runtime.instances/1" },
        { "capability": "runtime.transforms.state", "range": "^1.0.0", "binding": "runtime.transforms/1" },
        { "capability": "runtime.marker.state", "range": "^1.0.0", "binding": "runtime.marker/1", "optional": true },
        { "capability": "runtime.required-counter.state", "range": "^1.0.0", "binding": "runtime.required-counter/1", "optional": true },
        { "capability": "runtime.transforms.migration", "range": "^1.0.0", "optional": true }
      ],
      "execution": {
        "form": "native-in-process",
        "securityBoundary": "none",
        "requestedPowers": ["host-user-authority", "read-content-store", "write-content-store", "write-session-record"]
      },
      "module": "./service.mjs"
    }
  ]
}
