{
  "schema": "fpm.package/1",
  "id": "demo.motion",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "runtimeServices": [{
    "id": "service:demo.motion/1",
    "protocol": "fpm.runtime-service/1",
    "provides": [{
      "capability": "runtime.task",
      "version": "1.0.0",
      "exclusive": false,
      "cardinality": "collection",
      "member": "task:demo.motion/set-x/1",
      "binding": "runtime.task.demo-motion/1",
      "memberDependencies": [],
      "metadata": {
        "phase": "simulation",
        "snapshots": ["runtime.transforms.read"],
        "outputs": [{
          "channel": "runtime.transforms.commands",
          "composition": "ordered",
          "commitAfter": []
        }],
        "affinity": "any-worker",
        "reentrancy": "non-reentrant",
        "required": true,
        "failure": "abort-tick"
      }
    }],
    "requires": [],
    "execution": {
      "form": "native-in-process",
      "securityBoundary": "none",
      "requestedPowers": ["host-user-authority"]
    },
    "module": "./service.mjs"
  }]
}
