{
  "schema": "fpm.package/1",
  "id": "demo.scene-toolchain",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "provides": [
    {
      "capability": "fpm.handler.scene",
      "version": "1.0.0"
    }
  ],
  "handlers": [
    {
      "id": "handler:demo.scene-toolchain/1",
      "protocol": "fpm.handler-stdio/1",
      "handles": [
        "fpm.demo.mesh/1",
        "fpm.demo.visual-assembly/1",
        "fpm.demo.camera/1",
        "fpm.demo.worldspace/1",
        "fpm.demo.runtime/1",
        "fpm.demo.fail/1"
      ],
      "builds": [
        "fpm.render-bundle/1"
      ],
      "buildEnvironment": {
        "schema": "fpm.build-environment/1",
        "dimensions": []
      },
      "execution": {
        "form": "external-process",
        "securityBoundary": "none",
        "requestedPowers": [
          "read-declared-input-artifacts",
          "write-manager-staging"
        ]
      },
      "command": [
        "node",
        "./handler.mjs"
      ]
    }
  ]
}
