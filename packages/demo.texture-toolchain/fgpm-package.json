        "fgpm.demo.texture-file/1",
        "fgpm.demo.solid-colour/1",
        "fgpm.demo.environment-colour/1",
        "fgpm.demo.slow-colour/1",
        "fgpm.demo.transaction-fail/1"
      ],
      "buildEnvironment": {
