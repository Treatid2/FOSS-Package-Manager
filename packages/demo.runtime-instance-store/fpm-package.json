{
  "schema": "fpm.package/1",
  "id": "demo.runtime-instance-store",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "runtimeServices": [
    {
      "id": "service:demo.runtime-instance-store/1",
      "protocol": "fpm.runtime-service/1",
      "artifactAccess": "read",
      "provides": [
        { "capability": "runtime.instances.read", "version": "1.0.0", "exclusive": true, "binding": "runtime.instances/1" },
        { "capability": "runtime.instances.materialize", "version": "1.0.0", "exclusive": true, "binding": "runtime.instances/1" },
        { "capability": "runtime.instances.destroy", "version": "1.0.0", "exclusive": true, "binding": "runtime.instances/1" },
        { "capability": "runtime.instances.state", "version": "1.0.0", "exclusive": true, "binding": "runtime.instances/1" }
      ],
      "requires": [],
      "execution": {
        "form": "native-in-process",
        "securityBoundary": "none",
        "requestedPowers": ["host-user-authority"]
      },
      "module": "./service.mjs"
    }
  ]
}
