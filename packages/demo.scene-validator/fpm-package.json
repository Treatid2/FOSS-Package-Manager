{
  "schema": "fpm.package/1",
  "id": "demo.scene-validator",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "handlers": [
    {
      "id": "handler:demo.scene-validator/1",
      "protocol": "fpm.handler-stdio/1",
      "validates": [
        {
          "id": "validator:demo.scene-proposal/1",
          "phase": "proposal",
          "subjects": ["fpm.render-bundle/1"],
          "rules": ["rule:demo.scene/nonempty/1"]
        }
      ],
      "execution": {
        "form": "external-process",
        "securityBoundary": "none",
        "requestedPowers": []
      },
      "command": ["node", "./validator.mjs"]
    }
  ]
}
