{
  "schema": "fpm.package/1",
  "id": "demo.prototype-toolchain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "provides": [
    {
      "capability": "fpm.handler.prototype",
      "version": "1.0.0"
    }
  ],
  "handlers": [
    {
      "id": "handler:demo.prototype-toolchain/1",
      "protocol": "fpm.handler-stdio/1",
      "handles": [
        "fpm.demo.mesh/1",
        "fpm.demo.texture/1",
        "fpm.demo.visual-assembly/1",
        "fpm.demo.camera/1",
        "fpm.demo.worldspace/1",
        "fpm.demo.runtime/1",
        "fpm.demo.fail/1"
      ],
      "builds": [
        "fpm.render-scene/1"
      ],
      "command": [
        "node",
        "./handler.mjs"
      ]
    }
  ]
}
