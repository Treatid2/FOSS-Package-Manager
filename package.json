{
  "name": "foss-package-manager",
  "version": "0.4.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "description": "A language-laboratory prototype for governed package builds and capability-resolved live runtime services.",
  "scripts": {
    "build": "node src/cli.mjs build profiles/base.json",
    "build:green": "node src/cli.mjs build profiles/green-head.json",
    "demo": "node src/cli.mjs run profiles/green-head.json",
    "snapshot": "node src/cli.mjs run profiles/green-head.json --snapshot build/green-head/scene.svg",
    "generate:wasm": "node tools/generate-wasm-fixtures.mjs",
    "contracts:generate": "node tools/render-architecture-snapshot.mjs",
    "contracts:check": "node tools/render-architecture-snapshot.mjs --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  }
}
