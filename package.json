{
  "name": "foss-package-manager",
  "version": "0.3.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "description": "A language-laboratory prototype for governed, concurrent, transactional mod-native package composition.",
  "scripts": {
    "build": "node src/cli.mjs build profiles/base.json",
    "build:green": "node src/cli.mjs build profiles/green-head.json",
    "demo": "node src/cli.mjs run profiles/green-head.json",
    "snapshot": "node src/cli.mjs run profiles/green-head.json --snapshot build/green-head/scene.svg",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  }
}
