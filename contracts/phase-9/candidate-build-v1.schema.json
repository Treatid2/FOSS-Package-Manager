{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-package-manager.example/schema/phase-9/candidate-build-v1.schema.json",
  "title": "FGPM Phase 9 candidate, derived-package, and complete-build records",
  "x-fgpm-license": "Apache-2.0", "x-fgpm-steward": "fgpm.manager-core/3", "x-fgpm-status": "experimental-no-compatibility-promise",
  "x-fgpm-classification": "public-cross-process", "x-fgpm-identity-rule": "identity = sha256(stable-json(identityInputs)); observations do not enter identityInputs.",
  "oneOf": [{ "$ref": "#/$defs/candidate" }, { "$ref": "#/$defs/candidateBuild" }, { "$ref": "#/$defs/candidateValidation" }, { "$ref": "#/$defs/derivedPackage" }, { "$ref": "#/$defs/completeBuild" }],
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "status", "workspace", "baseGeneration", "packages", "choices", "target", "policy", "generatedRequests", "runtimePlan", "buildIntent", "selectionRoot", "findings", "impact", "indexes"],
      "properties": { "schema": { "const": "fgpm.candidate/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "status": { "enum": ["blocked", "ready-to-build"] },
        "workspace": { "type": "object" }, "baseGeneration": {}, "packages": { "type": "array" }, "choices": { "type": "object" }, "target": { "type": "object" }, "policy": { "type": "object" },
        "generatedRequests": { "type": "array" }, "runtimePlan": { "type": "object" }, "buildIntent": { "type": "object" }, "selectionRoot": { "$ref": "#/$defs/root" }, "findings": { "type": "array" }, "impact": { "type": "object" }, "indexes": { "type": "object" } } },
    "candidateBuild": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "status", "candidate", "derivedPackages", "completeBuild", "authority"],
      "properties": { "schema": { "const": "fgpm.candidate-build/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "status": { "const": "build-complete" },
        "candidate": { "$ref": "#/$defs/root" }, "derivedPackages": { "type": "array" }, "completeBuild": { "$ref": "#/$defs/root" }, "authority": { "type": "object" } } },
    "candidateValidation": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "status", "candidate", "build", "completeBuild", "authority", "acceptedFindings"],
      "properties": { "schema": { "const": "fgpm.candidate-validation/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "status": { "const": "validated" },
        "candidate": { "$ref": "#/$defs/root" }, "build": { "$ref": "#/$defs/root" }, "completeBuild": { "$ref": "#/$defs/root" }, "authority": { "type": "object" }, "acceptedFindings": { "type": "array" } } },
    "derivedPackage": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "key", "outputPackageRoot", "provenance", "generatorExecution"],
      "properties": { "schema": { "const": "fgpm.derived-package/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "key": { "$ref": "#/$defs/root" },
        "outputPackageRoot": { "$ref": "#/$defs/root" }, "provenance": { "type": "object" }, "generatorExecution": { "type": "object" } } },
    "completeBuild": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "candidate", "mode", "selectionRoot", "authoritativeSelectionRoot", "authorityMatch", "profileRoot", "resolutionRoot", "lockRoot", "policyRoot", "validationRoot", "actionRoot", "artifactClosureRoot", "activationArtifactRoot", "runtimePlanRoot", "closureRoot", "contractRoot", "profile", "runtimePlan", "activationArtifact"],
      "properties": { "schema": { "const": "fgpm.complete-build/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "candidate": { "$ref": "#/$defs/root" }, "mode": { "enum": ["complete-profile", "package-only"] },
        "selectionRoot": { "$ref": "#/$defs/root" }, "authoritativeSelectionRoot": { "$ref": "#/$defs/root" }, "authorityMatch": { "type": "boolean" }, "profileRoot": {}, "resolutionRoot": { "$ref": "#/$defs/root" },
        "lockRoot": { "$ref": "#/$defs/root" }, "policyRoot": { "$ref": "#/$defs/root" }, "validationRoot": { "$ref": "#/$defs/root" }, "actionRoot": { "$ref": "#/$defs/root" }, "artifactClosureRoot": { "$ref": "#/$defs/root" },
        "activationArtifactRoot": {}, "runtimePlanRoot": { "$ref": "#/$defs/root" }, "closureRoot": {}, "contractRoot": { "$ref": "#/$defs/root" }, "profile": {}, "runtimePlan": { "type": "object" }, "activationArtifact": {}, "observations": { "type": "object" } } }
  }
}
