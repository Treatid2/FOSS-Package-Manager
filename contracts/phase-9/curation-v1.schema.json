{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-package-manager.example/schema/phase-9/curation-v1.schema.json",
  "title": "FGPM Phase 9 package-store and workspace records",
  "x-fgpm-license": "Apache-2.0", "x-fgpm-steward": "fgpm.manager-core/3",
  "x-fgpm-status": "experimental-no-compatibility-promise", "x-fgpm-classification": "public-cross-process",
  "x-fgpm-identity-rule": "Immutable records use sha256(stable-json(identityInputs)); mutable references are explicitly non-content-addressed.",
  "oneOf": [{ "$ref": "#/$defs/installedIndex" }, { "$ref": "#/$defs/installedIndex2" }, { "$ref": "#/$defs/packageRoot" }, { "$ref": "#/$defs/workspaceReference" }, { "$ref": "#/$defs/workspaceRevision" }],
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "installedIndex2": { "type": "object", "additionalProperties": false, "required": ["schema", "version", "packages", "audit"], "properties": {
      "schema": { "const": "fgpm.installed-index/2" }, "version": { "const": 1 }, "packages": { "type": "array", "items": { "type": "object" } },
      "audit": { "type": "array", "minItems": 1, "items": { "type": "object" } } } },
    "installedIndex": { "type": "object", "additionalProperties": false, "required": ["schema", "version", "packages"], "properties": {
      "schema": { "const": "fgpm.installed-index/1" }, "version": { "const": 1 }, "packages": { "type": "array", "items": { "type": "object" } } } },
    "packageRoot": { "type": "object", "additionalProperties": false, "required": ["schema", "version", "identity", "id", "packageVersion", "root", "manifest"], "properties": {
      "schema": { "const": "fgpm.package-root/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "id": { "type": "string" },
      "packageVersion": { "type": "string" }, "root": { "$ref": "#/$defs/root" }, "manifest": { "type": "object" } } },
    "workspaceReference": { "type": "object", "additionalProperties": false, "required": ["schema", "version", "name", "workspaceIdentity", "revision", "baseGeneration", "updatedAt"], "properties": {
      "schema": { "const": "fgpm.workspace-reference/1" }, "version": { "const": 1 }, "name": { "type": "string" }, "workspaceIdentity": { "type": "string" },
      "revision": { "$ref": "#/$defs/root" }, "baseGeneration": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] }, "updatedAt": { "type": "string", "format": "date-time" } } },
    "workspaceRevision": { "type": "object", "additionalProperties": false, "required": ["schema", "version", "identity", "identityInputs", "workspaceIdentity", "parent", "baseGeneration", "operations", "attribution"], "properties": {
      "schema": { "const": "fgpm.workspace-revision/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" },
      "workspaceIdentity": { "type": "string" }, "parent": {}, "baseGeneration": {}, "operations": { "type": "array", "items": { "type": "object" } }, "attribution": { "type": "object" } } }
  }
}
