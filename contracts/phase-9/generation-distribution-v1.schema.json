{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://foss-package-manager.example/schema/phase-9/generation-distribution-v1.schema.json",
  "title": "FGPM Phase 9 executable generation and distribution records", "x-fgpm-license": "Apache-2.0", "x-fgpm-steward": "fgpm.manager-core/3",
  "x-fgpm-status": "experimental-no-compatibility-promise", "x-fgpm-classification": "public-cross-process",
  "x-fgpm-identity-rule": "identity = sha256(stable-json(identityInputs)); distribution file hashes verify the complete declared member set.",
  "oneOf": [{ "$ref": "#/$defs/generation" }, { "$ref": "#/$defs/distribution" }],
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generation": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "parent", "workspaceRevision", "candidate", "packages", "derivedPackages", "choices", "target", "policy", "runtimePlan", "stateOwners", "activationArtifact", "completeBuild", "roots", "publicContract", "manager", "impact"],
      "properties": { "schema": { "const": "fgpm.generation/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "parent": {}, "workspaceRevision": { "$ref": "#/$defs/root" },
        "candidate": { "$ref": "#/$defs/root" }, "packages": { "type": "array" }, "derivedPackages": { "type": "array" }, "choices": { "type": "object" }, "target": { "type": "object" }, "policy": { "type": "object" },
        "runtimePlan": { "type": "object" }, "stateOwners": { "type": "object" }, "activationArtifact": { "type": "object" }, "completeBuild": { "$ref": "#/$defs/root" }, "roots": { "type": "object" },
        "publicContract": { "type": "string" }, "manager": { "type": "string" }, "impact": { "type": "object" } } },
    "distribution": { "type": "object", "additionalProperties": false,
      "required": ["schema", "version", "identity", "identityInputs", "generation", "packages", "completeBuild"],
      "properties": { "schema": { "const": "fgpm.distribution/1" }, "version": { "const": 1 }, "identity": { "$ref": "#/$defs/root" }, "identityInputs": { "type": "object" }, "generation": { "$ref": "#/$defs/root" },
        "packages": { "type": "array" }, "completeBuild": { "$ref": "#/$defs/root" }, "publicContract": { "type": "string" }, "manager": { "type": "string" }, "files": { "type": "array" } } }
  }
}
