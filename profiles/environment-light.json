{
  "schema": "fpm.profile/2",
  "name": "environment-light",
  "packageRoots": ["../packages"],
  "distribution": {
    "roots": ["demo.environment-head", "demo.simple-runtime", "demo.solid-colour-adapter", "demo.worldspace"],
    "entryPoint": "pkg:demo.worldspace/world/demo",
    "artifact": { "type": "fpm.render-bundle/1", "builder": "handler:demo.scene-toolchain/1" },
    "activation": "runtime:demo.simple-runtime/browser-svg"
  },
  "target": {
    "platform": "portable-demo",
    "textureFormat": "rgba8-srgb",
    "colourVariant": "light",
    "observation": "first"
  },
  "policy": {
    "environmentKey": { "widen": ["host.platform", "host.architecture"] }
  },
  "user": { "roots": [], "replacements": {} }
}
