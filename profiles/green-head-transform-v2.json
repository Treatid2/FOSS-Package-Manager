{
  "schema": "fgpm.profile/2",
  "name": "green-head-transform-v2",
  "packageRoots": ["../packages"],
  "distribution": {
    "roots": [
      "demo.simple-runtime",
      "demo.scene-validator",
      "demo.solid-colour-adapter",
      "demo.worldspace",
      "demo.transform-authority-v2",
      "demo.transform-migration-v1-v2"
    ],
    "entryPoint": "pkg:demo.worldspace/world/demo",
    "artifact": { "type": "fgpm.render-bundle/1", "builder": "handler:demo.scene-toolchain/1" },
    "activation": "runtime:demo.simple-runtime/browser-svg"
  },
  "target": { "platform": "portable-demo", "textureFormat": "rgba8-srgb" },
  "policy": {
    "providers": { "runtime.transforms/1": "demo.transform-authority-v2" },
    "handlerSelections": {},
    "adapterSelections": {},
    "validation": {
      "id": "policy:demo.require-scene-validator/1",
      "requiredValidators": ["validator:demo.scene-proposal/1"],
      "waivers": []
    },
    "environmentKey": { "widen": ["host.platform", "host.architecture"] }
  },
  "user": { "roots": ["demo.green-head", "demo.character-marker"], "replacements": {} }
}
