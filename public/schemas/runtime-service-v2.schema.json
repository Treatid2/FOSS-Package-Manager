{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foss-package-manager.example/schema/runtime-service-v2.schema.json",
  "title": "FGPM corrected runtime service declaration",
  "x-fgpm-license": "Apache-2.0",
  "x-fgpm-identity": "fgpm.runtime-service/2",
  "x-fgpm-steward": "fgpm.manager-core/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "protocol", "provides", "requires", "artifactAccess", "artifactStoreAccess", "hostGrants", "execution", "module", "activationContract"],
  "properties": {
    "id": { "type": "string", "pattern": "^service:" },
    "protocol": { "const": "fgpm.runtime-service/2" },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "version", "cardinality"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "cardinality": { "enum": ["exclusive", "collection"] },
          "member": { "type": "string" },
          "binding": { "type": "string" },
          "memberDependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "metadata": { "type": "object" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "range", "cardinality"],
        "properties": {
          "capability": { "type": "string" }, "range": { "type": "string" },
          "cardinality": { "enum": ["exclusive", "collection"] }, "binding": { "type": "string" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "artifactAccess": { "enum": ["none", "read"] },
    "artifactStoreAccess": { "enum": ["none", "read", "read-write"] },
    "hostGrants": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^fgpm\\.host\\.[a-z0-9.-]+/1$" } },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["form", "securityBoundary", "requestedPowers"],
      "properties": {
        "form": { "const": "native-in-process" }, "securityBoundary": { "const": "none" },
        "requestedPowers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "module": { "type": "string", "minLength": 1 },
    "activationContract": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "service", "capabilities"],
      "properties": {
        "schema": { "const": "fgpm.runtime-service-activation/2" },
        "service": { "type": "string", "pattern": "^service:" },
        "capabilities": { "type": "object" }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "capabilities"],
      "properties": { "protocol": { "const": "fgpm.runtime-service-response/2" }, "capabilities": { "type": "object" } }
    }
  }
}
