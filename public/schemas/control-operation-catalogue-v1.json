      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.active-generation-state/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "active-1", "operation": "generation.active", "parameters": {} },
      "sessionRequirement": "same persistent control process to distinguish live from stale ownership", "preconditions": [], "failureCodes": [], "mutationBoundary": "read-only; reports stopped, live, or stale"
    },
    {
      "operation": "generation.activate", "maturity": "guided-project-supported", "authorityCategory": "generation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["root"], "properties": { "root": { "type": "string" } } }, "resultSchema": "fgpm.generation-transition/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "activate-1", "operation": "generation.activate", "parameters": { "root": "sha256:<generation>" } },
