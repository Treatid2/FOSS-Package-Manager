{
  "schema": "fgpm.control-operation-catalogue/1",
  "version": 1,
  "status": "experimental-no-compatibility-promise",
  "license": "Apache-2.0",
  "steward": "fgpm.manager-control/1",
  "transport": "fgpm.control-request/1",
  "processRule": "generation activation, runtime operations, transition or rollback, and shutdown must use one persistent control process",
  "transportReplay": {
    "meaning": "an identical requestId and canonical request returns the original executed response without a second dispatch",
    "authority": "the original operation authority record is preserved unchanged; transportReplay separately records that the later event dispatched nothing and moved no authority",
    "checkpointDistinction": "transport replay deduplicates a request before dispatch; checkpoint idempotent-reuse is a newly dispatched checkpoint capture that finds already-published immutable content"
  },
  "resultSchemas": {
    "fgpm.package-registry-inspection/1": { "type": "object", "required": ["schema", "indexSchema", "indexRoot", "objects", "audit", "retainedGenerations", "historicalObservation", "cleanup"], "properties": { "schema": { "const": "fgpm.package-registry-inspection/1" } } },
    "fgpm.control-description/1": { "type": "object", "required": ["schema", "operations", "operationCapabilities", "operationContracts", "transportReplay"], "properties": { "schema": { "const": "fgpm.control-description/1" } } },
    "fgpm.control-stop-result/1": { "type": "object", "required": ["schema", "active", "stop"], "properties": { "schema": { "const": "fgpm.control-stop-result/1" }, "stop": { "const": true } } },
    "fgpm.package-import-result/1": { "type": "object", "required": ["schema", "status", "package"], "properties": { "schema": { "const": "fgpm.package-import-result/1" } } },
    "fgpm.package-list/1": { "type": "object", "required": ["schema", "packages"], "properties": { "schema": { "const": "fgpm.package-list/1" } } },
    "fgpm.workspace-create-result/1": { "type": "object", "required": ["reference", "revision"] },
    "fgpm.workspace-export-result/1": { "type": "object", "required": ["schema", "directory", "workspace"], "properties": { "schema": { "const": "fgpm.workspace-export-result/1" } } },
    "fgpm.workspace-import-result/1": { "type": "object", "required": ["schema", "status", "reference", "revision", "history"], "properties": { "schema": { "const": "fgpm.workspace-import-result/1" } } },
    "fgpm.workspace-status/1": { "type": "object", "required": ["reference", "revision"] },
    "fgpm.workspace-history/1": { "type": "object", "required": ["schema", "name", "revisions"], "properties": { "schema": { "const": "fgpm.workspace-history/1" } } },
    "fgpm.workspace-stage-result/1": { "type": "object", "required": ["revision"], "anyOf": [{ "required": ["operation"] }, { "required": ["operations"] }] },
    "fgpm.candidate/1": { "type": "object", "required": ["schema", "identity"], "properties": { "schema": { "const": "fgpm.candidate/1" } } },
    "fgpm.candidate-explanation/1": { "type": "object", "required": ["candidate"] },
    "fgpm.candidate-build/1": { "type": "object", "required": ["schema", "identity"], "properties": { "schema": { "const": "fgpm.candidate-build/1" } } },
    "fgpm.candidate-validation/1": { "type": "object", "required": ["schema", "identity"], "properties": { "schema": { "const": "fgpm.candidate-validation/1" } } },
    "fgpm.generation-commit-result/1": { "type": "object", "required": ["generation"] },
    "fgpm.generation/1": { "type": "object", "required": ["schema", "identity"], "properties": { "schema": { "const": "fgpm.generation/1" } } },
    "fgpm.retained-generation-list/1": { "type": "object", "required": ["schema", "generations"], "properties": { "schema": { "const": "fgpm.retained-generation-list/1" } } },
    "fgpm.active-generation-state/1": { "type": "object", "required": ["schema", "status", "ownedByCurrentProcess", "active"], "properties": { "schema": { "const": "fgpm.active-generation-state/1" }, "status": { "enum": ["stopped", "live", "stale"] } } },
    "fgpm.generation-transition/1": { "type": "object", "required": ["schema", "status", "from", "to", "session", "transitionClass", "active", "preflight"], "properties": { "schema": { "const": "fgpm.generation-transition/1" }, "transitionClass": { "enum": ["initial-activation", "same-generation-reactivation", "distinct-generation-transition", "distinct-generation-rollback"] } } },
    "fgpm.stale-generation-clear-result/1": { "type": "object", "required": ["schema", "status", "generation", "session", "active"], "properties": { "schema": { "const": "fgpm.stale-generation-clear-result/1" } } },
    "fgpm.runtime-inspection/1": { "type": "object", "required": ["schema", "active", "live", "ownership", "generation", "session", "lifecycle", "instances"], "properties": { "schema": { "const": "fgpm.runtime-inspection/1" } } },
    "fgpm.public-runtime-session/1": { "type": "object", "required": ["schema", "handle", "generation", "runtimeSession", "capability", "protocol", "provider", "methods"], "properties": { "schema": { "const": "fgpm.public-runtime-session/1" } } },
    "fgpm.public-runtime-session-call/1": { "type": "object", "required": ["schema", "handle", "generation", "runtimeSession", "capability", "protocol", "provider", "method", "value"], "properties": { "schema": { "const": "fgpm.public-runtime-session-call/1" } } },
    "fgpm.public-runtime-session-close/1": { "type": "object", "required": ["schema", "handle", "generation", "runtimeSession", "closed", "value"], "properties": { "schema": { "const": "fgpm.public-runtime-session-close/1" }, "closed": { "const": true } } },
    "fgpm.generation-runtime-checkpoint-result/1": { "type": "object", "required": ["schema", "checkpoint", "publication"], "properties": { "schema": { "const": "fgpm.generation-runtime-checkpoint-result/1" }, "publication": { "type": "object", "required": ["class", "saveId", "checkpointIdentity", "contentRoot"], "properties": { "class": { "enum": ["first-publication", "idempotent-reuse"] }, "saveId": { "type": "string" }, "checkpointIdentity": { "type": "string" }, "contentRoot": { "type": ["string", "object", "null"] } } } } },
    "fgpm.generation-resume/1": { "type": "object", "required": ["schema", "status", "generation", "checkpoint", "session", "active"], "properties": { "schema": { "const": "fgpm.generation-resume/1" } } },
    "fgpm.runtime-shutdown-result/1": { "type": "object", "required": ["schema", "lifecycle", "active"], "properties": { "schema": { "const": "fgpm.runtime-shutdown-result/1" } } },
    "fgpm.distribution/1": { "type": "object", "required": ["schema", "identity", "generation", "packages", "completeBuild", "files"], "properties": { "schema": { "const": "fgpm.distribution/1" } } },
    "fgpm.distribution-import-result/1": { "type": "object", "required": ["manifest", "generation"] },
    "fgpm.distribution-verification/1": { "type": "object", "required": ["manifest", "generation", "completeBuild"] },
    "fgpm.manager-reachability-report/1": { "type": "object", "required": ["schema", "destructive", "generationRoots", "retainedPackageRoots"], "properties": { "schema": { "const": "fgpm.manager-reachability-report/1" } } }
  },
  "operations": [
    {
      "operation": "control.describe", "maturity": "guided-project-supported", "authorityCategory": "inspection",
      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.control-description/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "describe-1", "operation": "control.describe", "parameters": {} },
      "sessionRequirement": "none; this is the discovery starting point", "preconditions": [], "failureCodes": ["FGPM_CONTROL_REQUEST_INVALID"],
      "mutationBoundary": "read-only"
    },
    {
      "operation": "control.stop", "maturity": "guided-project-supported", "authorityCategory": "runtime-lifecycle",
      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.control-stop-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "stop-1", "operation": "control.stop", "parameters": {} },
      "sessionRequirement": "same persistent control process; safe with or without a live runtime", "preconditions": [], "failureCodes": [],
      "mutationBoundary": "owned runtime is shut down and its active reference is cleared before the process stops"
    },
    {
      "operation": "package.import", "maturity": "guided-project-supported", "authorityCategory": "project-curation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["directory"], "properties": { "directory": { "type": "string", "minLength": 1 }, "source": {} } }, "resultSchema": "fgpm.package-import-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "import-1", "operation": "package.import", "parameters": { "directory": "C:/author/package" } },
      "sessionRequirement": "persistent control process, no live runtime required", "preconditions": ["package validates in isolation"], "failureCodes": ["FGPM_PACKAGE_TREE_INVALID", "FGPM_PACKAGE_VERSION_CONFLICT"],
      "mutationBoundary": "default conflict checks precede publication; later failures may retain unregistered immutable content. Registry and audit commit together. No automatic variant opt-in."
    },
    {
      "operation": "package.registry.inspect", "maturity": "guided-project-supported", "authorityCategory": "inspection",
      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.package-registry-inspection/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "registry-1", "operation": "package.registry.inspect", "parameters": {} },
      "sessionRequirement": "no live runtime required", "preconditions": [], "failureCodes": ["FGPM_REGISTRY_AUDIT_INVALID"],
      "mutationBoundary": "no registry/content/generation mutation; temporary lease coordinates registry inspection, not an atomic runtime snapshot"
    },
    {
      "operation": "package.variant-register", "maturity": "expert-supported", "authorityCategory": "project-curation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["directory", "expectedRoot", "registrationId", "reason", "source"], "properties": {
        "directory": { "type": "string", "minLength": 1 }, "expectedRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expectedIndexRoot": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "registrationId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "source": {} } },
      "resultSchema": "fgpm.package-import-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "variant-1", "operation": "package.variant-register", "parameters": { "directory": "C:/author/package", "expectedRoot": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "registrationId": "author:variant-1", "reason": "Explicit assessed candidate", "source": "author commission" } },
      "sessionRequirement": "no live runtime required; immutable selection unchanged", "preconditions": ["exact expectedRoot, opt-in reason/provenance and durable registrationId", "optional expectedIndexRoot compare-and-swap"],
      "failureCodes": ["FGPM_VARIANT_REGISTRATION_INVALID", "FGPM_VARIANT_IDEMPOTENCY_CONFLICT", "FGPM_REGISTRY_HEAD_CONFLICT"],
      "mutationBoundary": "registers an exact available variant, never overwrites predecessors or selects it; records observed prior residue, migration root and registration atomically with index. Later storage failure can retain inspectable unregistered objects."
    },
    {
      "operation": "package.list", "maturity": "guided-project-supported", "authorityCategory": "inspection",
      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.package-list/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "packages-1", "operation": "package.list", "parameters": {} },
      "sessionRequirement": "none", "preconditions": [], "failureCodes": [], "mutationBoundary": "read-only"
    },
    {
      "operation": "workspace.create", "maturity": "expert-supported", "authorityCategory": "expert/debug",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "baseGeneration": { "type": ["string", "null"] }, "actor": { "type": "string" } } }, "resultSchema": "fgpm.workspace-create-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "workspace-1", "operation": "workspace.create", "parameters": { "name": "author-workspace" } },
      "sessionRequirement": "persistent control process, no live runtime required", "preconditions": ["workspace name is unused"], "failureCodes": ["FGPM_WORKSPACE_NAME_INVALID", "FGPM_WORKSPACE_EXISTS"], "mutationBoundary": "workspace reference is published last"
    },
    {
      "operation": "workspace.fork", "maturity": "expert-supported", "authorityCategory": "expert/debug",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["generation", "name"], "properties": { "generation": { "type": "string" }, "name": { "type": "string" }, "actor": { "type": "string" } } }, "resultSchema": "fgpm.workspace-create-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "fork-1", "operation": "workspace.fork", "parameters": { "generation": "sha256:<generation>", "name": "fork" } },
      "sessionRequirement": "persistent control process", "preconditions": ["generation exists"], "failureCodes": ["FGPM_GENERATION_NOT_FOUND", "FGPM_WORKSPACE_EXISTS"], "mutationBoundary": "workspace reference is published last"
    },
    {
      "operation": "workspace.export", "maturity": "expert-supported", "authorityCategory": "expert/debug",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name", "directory"], "properties": { "name": { "type": "string" }, "directory": { "type": "string" } } }, "resultSchema": "fgpm.workspace-export-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "workspace-export-1", "operation": "workspace.export", "parameters": { "name": "author-workspace", "directory": "C:/out/workspace" } },
      "sessionRequirement": "persistent control process", "preconditions": ["workspace exists", "output is empty"], "failureCodes": ["FGPM_WORKSPACE_NOT_FOUND"], "mutationBoundary": "manager authority is read-only; external export publishes last"
    },
    {
      "operation": "workspace.import", "maturity": "guided-project-supported", "authorityCategory": "project-curation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "type": "string" } } }, "resultSchema": "fgpm.workspace-import-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "workspace-import-1", "operation": "workspace.import", "parameters": { "source": "C:/in/workspace" } },
      "sessionRequirement": "persistent control process", "preconditions": ["portable history verifies"], "failureCodes": ["FGPM_WORKSPACE_IMPORT_INVALID"], "mutationBoundary": "complete history verifies before a mutable reference is created"
    },
    {
      "operation": "workspace.status", "maturity": "guided-project-supported", "authorityCategory": "inspection",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } }, "resultSchema": "fgpm.workspace-status/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "workspace-status-1", "operation": "workspace.status", "parameters": { "name": "author-workspace" } },
      "sessionRequirement": "none", "preconditions": ["workspace exists"], "failureCodes": ["FGPM_WORKSPACE_NOT_FOUND"], "mutationBoundary": "read-only"
    },
    {
      "operation": "workspace.history", "maturity": "guided-project-supported", "authorityCategory": "inspection",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" } } }, "resultSchema": "fgpm.workspace-history/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "workspace-history-1", "operation": "workspace.history", "parameters": { "name": "author-workspace" } },
      "sessionRequirement": "none", "preconditions": ["workspace exists"], "failureCodes": ["FGPM_WORKSPACE_NOT_FOUND"], "mutationBoundary": "read-only"
    },
    {
      "operation": "workspace.stage", "maturity": "guided-project-supported", "authorityCategory": "project-curation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" }, "operation": { "$ref": "workspace-operation-v1.schema.json" }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "workspace-operation-v1.schema.json" } }, "expectedHead": { "type": "string" }, "actor": { "type": "string" } }, "oneOf": [{ "required": ["operation"] }, { "required": ["operations"] }] }, "resultSchema": "fgpm.workspace-stage-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "stage-add-1", "operation": "workspace.stage", "parameters": { "name": "author-workspace", "operation": { "type": "add", "packageRoot": "sha256:<package-root>" }, "expectedHead": "sha256:<workspace-head>", "actor": "author:external" } },
      "sessionRequirement": "persistent control process", "preconditions": ["workspace exists", "expectedHead equals current revision", "package root is already imported"], "failureCodes": ["FGPM_WORKSPACE_OPERATION_INVALID", "FGPM_WORKSPACE_OPERATION_UNKNOWN_FIELD", "FGPM_WORKSPACE_REVISION_CONFLICT"], "mutationBoundary": "compare-and-swap succeeds before the workspace reference moves",
      "idempotence": "requestId replay is idempotent within one control process; a new request appends a new immutable revision",
      "duplicateBehavior": "repeating an already-applied operation under a new request identity is explicit history, not silent deduplication"
    },
    {
      "operation": "workspace.plan", "maturity": "guided-project-supported", "authorityCategory": "project-curation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" }, "profilePath": { "type": "string" }, "buildIntent": { "type": "object" }, "runtimePlan": { "type": "object" } } }, "resultSchema": "fgpm.candidate/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "plan-1", "operation": "workspace.plan", "parameters": { "name": "author-workspace" } },
      "sessionRequirement": "persistent control process", "preconditions": ["workspace package closure is resolvable"], "failureCodes": ["FGPM_CANDIDATE_BLOCKED"], "mutationBoundary": "candidate is immutable; workspace reference is unchanged"
    },
    {
      "operation": "candidate.explain", "maturity": "guided-project-supported", "authorityCategory": "inspection",
