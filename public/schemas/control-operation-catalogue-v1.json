      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "validate-1", "operation": "candidate.validate", "parameters": { "root": "sha256:<build>" } },
      "sessionRequirement": "persistent control process", "preconditions": ["candidate build exists"], "failureCodes": ["FGPM_CANDIDATE_VALIDATION_FAILED"], "mutationBoundary": "validation is immutable and does not select a generation"
    },
    {
      "operation": "generation.commit", "maturity": "guided-project-supported", "authorityCategory": "generation",
      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["validationRoot"], "properties": { "validationRoot": { "type": "string" }, "name": { "type": "string" }, "expectedGenerationRoot": { "type": "string" } } }, "resultSchema": "fgpm.generation-commit-result/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "commit-1", "operation": "generation.commit", "parameters": { "validationRoot": "sha256:<validation>" } },
      "sessionRequirement": "persistent control process", "preconditions": ["validation is accepted"], "failureCodes": ["FGPM_GENERATION_ROOT_MISMATCH", "FGPM_WORKSPACE_REVISION_CONFLICT"], "mutationBoundary": "expected identities verify before the workspace base reference moves"
    },
