      "parameterSchema": { "type": "object", "additionalProperties": false }, "resultSchema": "fgpm.retained-generation-list/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "generations-1", "operation": "generation.retained", "parameters": {} },
