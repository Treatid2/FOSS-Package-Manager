      "sessionRequirement": "same persistent control process that owns the live runtime", "preconditions": ["target is a different retained generation", "current live session is owned"], "failureCodes": ["FGPM_GENERATION_ROLLBACK_SESSION_REQUIRED", "FGPM_GENERATION_ROLLBACK_TARGET_UNCHANGED", "FGPM_ACTIVE_RUNTIME_SESSION_STALE", "FGPM_GENERATION_TRANSITION_FAILED"], "mutationBoundary": "owned live-session and distinct-target preconditions pass before target construction; then the old runtime shuts down before the distinct target generation activates and a new session becomes authoritative"
