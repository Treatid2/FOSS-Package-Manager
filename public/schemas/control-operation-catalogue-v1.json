      "parameterSchema": { "type": "object", "additionalProperties": false, "required": ["root"], "properties": { "root": { "type": "string" } } }, "resultSchema": "fgpm.candidate-build/1",
      "minimalRequest": { "schema": "fgpm.control-request/1", "requestId": "build-1", "operation": "candidate.build", "parameters": { "root": "sha256:<candidate>" } },
      "sessionRequirement": "persistent control process", "preconditions": ["candidate is ready"], "failureCodes": ["FGPM_CANDIDATE_BLOCKED"], "mutationBoundary": "outputs remain immutable and unselected"
    },
    {
      "operation": "candidate.validate", "maturity": "guided-project-supported", "authorityCategory": "build",
